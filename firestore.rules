rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // CATCH-ALL RULE MAINTAINED DURING MIGRATION PHASE
    // DO NOT DEPLOY RESTRICTIVE RULES TO PRODUCTION UNTIL AUTH MIGRATION IS COMPLETE
    match /{document=**} {
      allow read, write: if true;
    }

    // Individual rules are defined below for validation and staging testing
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
