{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "An item in the inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Item name" },
        "unit": { "type": "string", "description": "Unit (e.g., kilo, piece)" },
        "price": { "type": "number", "description": "Unit price" },
        "department": { "type": "string", "description": "Department/Stage" },
        "warehouseId": { "type": "string", "description": "ID of the warehouse" },
        "openingBalance": { "type": "number", "description": "Opening balance" },
        "inward": { "type": "number", "description": "Total inward" },
        "outward": { "type": "number", "description": "Total outward" },
        "returned": { "type": "number", "description": "Total returned" },
        "currentBalance": { "type": "number", "description": "Current balance" },
        "safetyLimit": { "type": "number", "description": "Safety limit" }
      },
      "required": ["name", "unit", "warehouseId"]
    },
    "Warehouse": {
      "title": "Warehouse",
      "description": "A warehouse or storage location",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Warehouse name" }
      },
      "required": ["name"]
    },
    "Unit": {
      "title": "Unit",
      "description": "A unit of measurement",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Unit name" }
      },
      "required": ["name"]
    },
    "CostCenter": {
      "title": "CostCenter",
      "description": "A cost center or production stage",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Cost center name" }
      },
      "required": ["name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A supplier of raw materials",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Supplier name" },
        "totalPurchases": { "type": "number", "description": "Total purchase amount" },
        "totalPayments": { "type": "number", "description": "Total paid amount" },
        "balance": { "type": "number", "description": "Remaining balance" },
        "openingBalance": { "type": "number", "description": "Initial balance we owe them" },
        "legacyBalance": { "type": "number", "description": "Legacy cached balance for supplier" },
        "currentBalance": { "type": "number", "description": "Dynamic ledger-calculated balance for supplier" }
      },
      "required": ["name"]
    },
    "SupplierLedgerEntry": {
      "title": "SupplierLedgerEntry",
      "description": "A modernized, double-entry supplier ledger transaction record",
      "type": "object",
      "properties": {
        "transactionNo": { "type": "string" },
        "supplierId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["OPENING", "PURCHASE", "PAYMENT", "RETURN", "ADJUSTMENT"] },
        "amount": { "type": "number" },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "referenceId": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transactionNo", "supplierId", "date", "type", "amount", "direction"]
    },
    "Customer": {
      "title": "Customer",
      "description": "A company or individual customer",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "balance": { "type": "number" },
        "openingBalance": { "type": "number" },
        "legacyBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "creditLimit": { "type": "number" },
        "taxId": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["name"]
    },
    "CustomerLedgerEntry": {
      "title": "CustomerLedgerEntry",
      "description": "A modernized, double-entry customer ledger transaction record",
      "type": "object",
      "properties": {
        "transactionNo": { "type": "string" },
        "customerId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["OPENING", "SALE", "PAYMENT", "RETURN", "ADJUSTMENT"] },
        "amount": { "type": "number" },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "referenceId": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transactionNo", "customerId", "date", "type", "amount", "direction"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A purchase transaction",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "supplierId": { "type": "string" },
        "itemId": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["آجل", "نقدي", "شيك"] },
        "notes": { "type": "string" }
      },
      "required": ["date", "supplierId", "itemId", "quantity"]
    },
    "Issuance": {
      "title": "Issuance",
      "description": "A material issuance transaction",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "jobOrderNo": { "type": "string" },
        "itemId": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "price": { "type": "number" },
        "total": { "type": "number" },
        "costCenter": { "type": "string" }
      },
      "required": ["date", "itemId", "quantity"]
    },
    "ProductionJob": {
      "title": "ProductionJob",
      "description": "A manufacturing order in the production line",
      "type": "object",
      "properties": {
        "orderNo": { "type": "string" },
        "clientName": { "type": "string" },
        "productName": { "type": "string" },
        "salesPerson": { "type": "string" },
        "isCustom": { "type": "boolean" },
        "components": { "type": "string" },
        "referenceImage": { "type": "string" },
        "woodType": { "type": "string" },
        "dimensions": { "type": "string" },
        "paintColor": { "type": "string" },
        "fabricType": { "type": "string" },
        "upholsteryDetails": { "type": "string" },
        "technicalSpecs": { "type": "string" },
        "cuttingListUrl": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "estimatedCost": { "type": "number" },
        "contractDate": { "type": "string", "format": "date" },
        "startDate": { "type": "string", "format": "date" },
        "deadline": { "type": "string", "format": "date" },
        "status": { "type": "string" },
        "workflowStep": { "type": "number" },
        "priority": { "type": "string", "enum": ["منخفضة", "متوسطة", "عالية"] },
        "qualityStatus": { "type": "string", "enum": ["pending", "approved", "failed"] },
        "qualityNotes": { "type": "string" },
        "notes": { "type": "string" },
        "readyForDelivery": { "type": "boolean" }
      },
      "required": ["orderNo", "productName", "status"]
    },
    "LoadingManifest": {
      "title": "LoadingManifest",
      "description": "A truck loading manifest",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "driverName": { "type": "string" },
        "carNumber": { "type": "string" },
        "destinationType": { "type": "string", "enum": ["عميل", "معرض"] },
        "clientName": { "type": "string" },
        "orderNumbers": { "type": "string" },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "components": { "type": "string" },
              "notes": { "type": "string" },
              "salesPerson": { "type": "string" },
              "additions": { "type": "string" }
            }
          }
        },
        "loaderName": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["date", "driverName", "carNumber", "destinationType", "clientName"]
    },
    "Waste": {
      "title": "Waste",
      "description": "A record of wasted or damaged items",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "itemId": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["date", "itemId", "quantity", "reason"]
    },
    "BladeSharpening": {
      "title": "BladeSharpening",
      "description": "A record of blade sharpening maintenance",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "bladeName": { "type": "string" },
        "quantity": { "type": "number" },
        "cost": { "type": "number" },
        "notes": { "type": "string" },
        "safeId": { "type": "string" },
        "safeTransactionId": { "type": "string" }
      },
      "required": ["date", "bladeName", "quantity"]
    },
    "PlateSharpening": {
      "title": "PlateSharpening",
      "description": "A record of plate sharpening maintenance",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "plateName": { "type": "string" },
        "quantity": { "type": "number" },
        "cost": { "type": "number" },
        "notes": { "type": "string" },
        "safeId": { "type": "string" },
        "safeTransactionId": { "type": "string" }
      },
      "required": ["date", "plateName", "quantity"]
    },
    "MachineMaintenance": {
      "title": "MachineMaintenance",
      "description": "A record of machine and equipment maintenance",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "machineName": { "type": "string" },
        "maintenanceType": { "type": "string" },
        "cost": { "type": "number" },
        "notes": { "type": "string" },
        "safeId": { "type": "string" },
        "safeTransactionId": { "type": "string" }
      },
      "required": ["date", "machineName", "maintenanceType"]
    },
    "Employee": {
      "title": "Employee",
      "description": "An employee in the company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "position": { "type": "string" },
        "department": { "type": "string" },
        "dailyRate": { "type": "number" },
        "payMethod": { "type": "string", "enum": ["daily", "production"] },
        "pieceRate": { "type": "number" },
        "phone": { "type": "string" },
        "hireDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["نشط", "موقوف", "مستقيل"] }
      },
      "required": ["name", "dailyRate", "status", "payMethod"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "status": { "type": "string", "enum": ["حضور", "غياب", "تأخير", "إجازة"] }
      },
      "required": ["employeeId", "date", "status"]
    },
    "FinancialTransaction": {
      "title": "FinancialTransaction",
      "description": "HR financial transaction",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["مكافأة", "خصم", "بدل", "إضافي"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "overtimeHours": { "type": "number" },
        "overtimeRate": { "type": "number", "enum": [1.33, 1.5, 2] }
      },
      "required": ["employeeId", "date", "type", "amount"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Employee loan record",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["نشط", "مسدد"] }
      },
      "required": ["employeeId", "date", "amount", "status"]
    },
    "Payroll": {
      "title": "Payroll",
      "description": "Employee payroll record",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "CALCULATED", "APPROVED", "POSTED", "PAID"] },
        "baseSalary": { "type": "number" },
        "earnings": { "type": "array", "items": { "type": "object" } },
        "deductions": { "type": "array", "items": { "type": "object" } },
        "grossEarnings": { "type": "number" },
        "totalDeductions": { "type": "number" },
        "netSalary": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "month", "year", "status", "baseSalary", "grossEarnings", "totalDeductions", "netSalary", "createdAt"]
    },
    "ProductionRecord": {
      "title": "ProductionRecord",
      "description": "A record of production work for an employee",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "rate": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["employeeId", "date", "quantity", "rate"]
    },
    "SupplierPayment": {
      "title": "SupplierPayment",
      "description": "Payment made to a supplier",
      "type": "object",
      "properties": {
        "supplierId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["نقدي", "شيك", "تحويل بنكي"] },
        "referenceNumber": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["supplierId", "date", "amount", "paymentMethod"]
    },
    "JobLabor": {
      "title": "JobLabor",
      "description": "Labor cost record for a production job",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "employeeId": { "type": "string" },
        "stage": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "hours": { "type": "number" },
        "rate": { "type": "number" },
        "total": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["jobId", "employeeId", "stage", "date", "hours", "total"]
    },
    "JobOtherCost": {
      "title": "JobOtherCost",
      "description": "Other cost record for a production job",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "stage": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["jobId", "stage", "date", "description", "amount"]
    },
    "DeliveryReceipt": {
      "title": "DeliveryReceipt",
      "description": "A client delivery receipt",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "clientName": { "type": "string" },
        "branch": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "notes": { "type": "string" }
            }
          }
        },
        "productRating": { "type": "string", "enum": ["مقبول", "جيد", "جيد جداً", "ممتاز"] },
        "teamRating": { "type": "string", "enum": ["مقبول", "جيد", "جيد جداً", "ممتاز"] },
        "notes": { "type": "string" }
      },
      "required": ["date", "clientName", "branch", "products"]
    },
    "StockAudit": {
      "title": "StockAudit",
      "description": "A warehouse stock audit record",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "warehouseId": { "type": "string" },
        "auditItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "itemName": { "type": "string" },
              "systemStock": { "type": "number" },
              "actualStock": { "type": "number" },
              "difference": { "type": "number" }
            }
          }
        },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["date", "warehouseId", "auditItems"]
    },
    "User": {
      "title": "User",
      "description": "A system user with specific module permissions",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "permissions": {
          "type": "object",
          "properties": {
            "dashboard": { "type": "boolean" },
            "inventory": { "type": "boolean" },
            "production": { "type": "boolean" },
            "maintenance": { "type": "boolean" },
            "purchases": { "type": "boolean" },
            "hr": { "type": "boolean" },
            "reports": { "type": "boolean" },
            "suppliers": { "type": "boolean" },
            "settings": { "type": "boolean" },
            "finance": { "type": "boolean" }
          }
        }
      },
      "required": ["email"]
    },
    "BOM": {
      "title": "BOM",
      "description": "Bill of Materials for a product",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object", "properties": { "itemId": { "type": "string" }, "quantity": { "type": "number" } } } },
        "totalExpectedMaterialCost": { "type": "number" }
      },
      "required": ["productId", "items"]
    },
    "WorkCenter": {
      "title": "WorkCenter",
