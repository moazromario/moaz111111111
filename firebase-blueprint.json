              "totalCost": { "type": "number" },
              "notes": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "quantity": { "type": "number" },
