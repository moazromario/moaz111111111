      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "totalEstimatedCost": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "departments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
