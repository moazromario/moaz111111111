rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // STAGING SECURED FIRESTORE RULES (TESTABLE & ISOLATED)
    // Primary Identity: Firebase Auth UID (request.auth.uid)
    // Document Identity: /users/{uid}
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUid() {
      return request.auth.uid;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.super_admin == true ||
        request.auth.token.email.lower() == "cfo.moaz@gmail.com" ||
        (hasUserDoc() && getUserDoc().role == "super_admin")
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.role == "admin" ||
          (hasUserDoc() && (getUserDoc().role == "admin" || getUserDoc().isAdmin == true))
        )
      );
    }

    function hasRole(role) {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == role ||
        (hasUserDoc() && (
          getUserDoc().role == role ||
          getUserDoc().permissions[role] == true
        ))
      );
    }

    // ===============================================================
    // Collection Rules Matrix
    // ===============================================================

    // 1. User Management
    match /users/{userId} {
      allow read: if isAuthenticated() && (getUid() == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // 2. System Settings
    match /settings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Warehouses & Inventory
    match /warehouses/{id} {
      allow read: if hasRole('inventory') || hasRole('reports');
      allow write: if hasRole('inventory');
    }

    match /units/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('inventory');
    }

    match /costCenters/{id} {
      allow read: if hasRole('finance') || hasRole('reports');
      allow write: if hasRole('finance');
    }

    match /items/{itemId} {
      allow read: if hasRole('inventory') || hasRole('production') || hasRole('purchasing') || hasRole('reports');
      allow write: if hasRole('inventory');
    }

    // 4. Purchasing & Suppliers
    match /suppliers/{supplierId} {
      allow read: if hasRole('purchasing') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('purchasing');
    }

    match /purchases/{purchaseId} {
      allow read: if hasRole('purchasing') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('purchasing');
    }

    match /supplierPayments/{id} {
      allow read: if hasRole('purchasing') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('purchasing') || hasRole('finance');
    }

    // 5. Manufacturing & Work Orders
    match /issuances/{issuanceId} {
      allow read: if hasRole('inventory') || hasRole('production') || hasRole('reports');
      allow write: if hasRole('inventory') || hasRole('production');
    }

    match /productionJobs/{jobId} {
      allow read: if hasRole('production') || hasRole('reports');
      allow write: if hasRole('production');
    }

    match /furnitureWorkOrders/{orderId} {
      allow read: if hasRole('production') || hasRole('sales') || hasRole('reports');
      allow write: if hasRole('production') || hasRole('sales');
    }

    match /loadingManifests/{manifestId} {
      allow read: if hasRole('production') || hasRole('sales') || hasRole('reports');
      allow write: if hasRole('production');
    }

    match /waste/{wasteId} {
      allow read: if hasRole('inventory') || hasRole('production') || hasRole('reports');
      allow write: if hasRole('inventory') || hasRole('production');
    }

    match /boms/{id} {
      allow read: if hasRole('production') || hasRole('inventory') || hasRole('reports');
      allow write: if hasRole('production');
    }

    match /workCenters/{id} {
      allow read: if hasRole('production') || hasRole('reports');
      allow write: if hasRole('production');
    }

    match /manufacturingOperations/{id} {
      allow read: if hasRole('production') || hasRole('reports');
      allow write: if hasRole('production');
    }

    match /productRecipes/{id} {
      allow read: if hasRole('production') || hasRole('inventory') || hasRole('reports');
      allow write: if hasRole('production');
    }

    match /productionRecords/{id} {
      allow read: if hasRole('production') || hasRole('hr') || hasRole('reports');
      allow write: if hasRole('production') || hasRole('hr');
    }

    match /jobLabors/{id} {
      allow read: if hasRole('production') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('production');
    }

    match /jobOtherCosts/{id} {
      allow read: if hasRole('production') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('production') || hasRole('finance');
    }

    match /mrpOrders/{id} {
      allow read: if hasRole('production') || hasRole('purchasing') || hasRole('reports');
      allow write: if hasRole('production') || hasRole('purchasing');
    }

    match /mrpScrap/{id} {
      allow read: if hasRole('production') || hasRole('inventory') || hasRole('reports');
      allow write: if hasRole('production') || hasRole('inventory');
    }

    match /productionRates/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('hr') || hasRole('production');
    }

    // 6. Maintenance
    match /bladeSharpening/{id} {
      allow read: if hasRole('maintenance') || hasRole('reports');
      allow write: if hasRole('maintenance');
    }

    match /plateSharpening/{id} {
      allow read: if hasRole('maintenance') || hasRole('reports');
      allow write: if hasRole('maintenance');
    }

    match /maintenanceOrders/{id} {
      allow read: if hasRole('maintenance') || hasRole('reports');
      allow write: if hasRole('maintenance');
    }

    match /vehicles/{id} {
      allow read: if hasRole('maintenance') || hasRole('production') || hasRole('reports');
      allow write: if hasRole('maintenance') || hasRole('production');
    }

    match /vehicleExpenses/{id} {
      allow read: if hasRole('maintenance') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('maintenance') || hasRole('finance');
    }

    // 7. HR & Payroll
    match /employees/{id} {
      allow read: if hasRole('hr') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('hr');
    }

    match /attendance/{id} {
      allow read: if hasRole('hr') || hasRole('reports');
      allow write: if hasRole('hr');
    }

    match /hrTransactions/{id} {
      allow read: if hasRole('hr') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('hr');
    }

    match /loans/{id} {
      allow read: if hasRole('hr') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('hr') || hasRole('finance');
    }

    match /payrolls/{id} {
      allow read: if hasRole('hr') || hasRole('finance') || isAdmin();
      allow write: if hasRole('hr') || isAdmin();
    }

    // 8. Sales & Customers
    match /customers/{customerId} {
      allow read: if hasRole('sales') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('sales');
    }

    match /salesOrders/{id} {
      allow read: if hasRole('sales') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('sales');
    }

    match /deliveryReceipts/{id} {
      allow read: if hasRole('sales') || hasRole('production') || hasRole('reports');
      allow write: if hasRole('sales') || hasRole('production');
    }

    match /deliveryDocuments/{id} {
      allow read: if hasRole('sales') || hasRole('production') || hasRole('reports');
      allow write: if hasRole('sales') || hasRole('production');
    }

    match /byproductSales/{id} {
      allow read: if hasRole('sales') || hasRole('finance') || hasRole('reports');
      allow write: if hasRole('sales') || hasRole('finance');
    }

    match /lostSales/{id} {
      allow read: if hasRole('sales') || hasRole('reports');
      allow write: if hasRole('sales');
    }

    // 9. Showroom
    match /showrooms/{id} {
      allow read: if hasRole('sales') || hasRole('showroom') || hasRole('reports');
      allow write: if hasRole('sales') || hasRole('showroom') || isAdmin();
    }

    match /showroomInventory/{id} {
      allow read: if hasRole('sales') || hasRole('showroom') || hasRole('inventory') || hasRole('reports');
      allow write: if hasRole('showroom') || hasRole('inventory');
    }

    match /transferOrders/{id} {
      allow read: if hasRole('sales') || hasRole('showroom') || hasRole('inventory') || hasRole('reports');
      allow write: if hasRole('showroom') || hasRole('inventory');
    }

    // 10. Treasury & Banking (Financial Data)
    match /safes/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /safeTransactions/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /safeAudits/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /safeSettlements/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /banks/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /bankTransactions/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /bankChecks/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /treasuryCustodies/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    match /custodySettlements/{id} {
      allow read: if hasRole('finance') || isAdmin();
      allow write: if hasRole('finance') || isAdmin();
    }

    // 11. Audits & Logs
    match /stockAudits/{id} {
      allow read: if hasRole('inventory') || hasRole('reports');
      allow create: if hasRole('inventory');
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 12. Chat & Communication
    match /chatMessages/{id} {
      allow read, write: if isAuthenticated();
    }
  }
}
